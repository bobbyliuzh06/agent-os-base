@echo off
setlocal enabledelayedexpansion
REM ===== agent-os 演化调度：propose -> gate（串行，不自动合并）=====
set "PYTHON_EXE=python"
set "SCRIPTS=D:/agent-os/BASE/scripts"
set "LOG=D:/agent-os/BASE/regression-runs/dispatch.log"
set "GATE_STATE=D:/agent-os/BASE/scripts/gate_state.json"

for /f "tokens=1-3 delims=/ " %%a in ("%date%") do set "TODAY=%%a-%%b-%%c"
for /f "tokens=1-2 delims=:." %%a in ("%time%") do set "NOW=%%a:%%b"
echo. >> "%LOG%"
echo ========== [%TODAY% %NOW%] dispatch start ========== >> "%LOG%"

REM --- 阶段1: propose (扫描+headless 评审) ---
echo [%NOW%] [1/2] propose: evolve_dispatch.py >> "%LOG%"
"%PYTHON_EXE%" "%SCRIPTS%/evolve_dispatch.py" >> "%LOG%" 2>&1
set "RC1=%ERRORLEVEL%"
echo [%NOW%] [1/2] propose rc=%RC1% >> "%LOG%"
if not "%RC1%"=="0" (
  echo [%NOW%] [ALERT] propose 失败，仍继续 gate（若无可门控 review 会自动跳过） >> "%LOG%"
)

REM --- 阶段2: gate (独立进程，对 review.txt 裁决) ---
echo [%NOW%] [2/2] gate: gate_review_dispatch.py >> "%LOG%"
"%PYTHON_EXE%" "%SCRIPTS%/gate_review_dispatch.py" >> "%LOG%" 2>&1
set "RC2=%ERRORLEVEL%"
echo [%NOW%] [2/2] gate rc=%RC2% >> "%LOG%"

REM --- 阶段3: 降级 unknown + 汇总告警 ---
"%PYTHON_EXE%" "%SCRIPTS%/postprocess_dispatch.py" >> "%LOG%" 2>&1
set "RC3=%ERRORLEVEL%"

echo [%NOW%] summary: propose_rc=%RC1% gate_rc=%RC2% post_rc=%RC3% >> "%LOG%"
if not "%RC1%"=="0" ( echo [ALERT] propose rc=%RC1% >> "%LOG%" )
if not "%RC2%"=="0" ( echo [ALERT] gate rc=%RC2% >> "%LOG%" )
echo ========== [%NOW%] dispatch end ========== >> "%LOG%"
endlocal