#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os, re, sys, json, hashlib, subprocess, shlex, shutil
from datetime import datetime

BASE_DIR = "D:/agent-os/BASE"
PROJECTS_DIR = "D:/agent-os/PROJECTS"
PENDING_DIR = "D:/agent-os/PENDING"
STATE_FILE = os.path.join(BASE_DIR, "scripts", "state.json")

# dsh 配置（与本机 dsh web --dump-config 一致）
DSH_BIN = "dsh"
DSH_PROFILE = "headless"
DSH_PROVIDER = "deepseek-official"
DSH_MODEL = "deepseek-flash"
REVIEW_ENABLED = True

# ---------- API key 注入（只读注册表/环境变量，绝不打印、绝不写库） ----------
def get_api_key():
    # 1) 当前进程环境变量
    val = os.environ.get("DEEPSEEK_API_KEY", "").strip()
    if val:
        return val
    # 2) Windows 注册表：用户级 HKCU\Environment
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment") as key:
            val, _ = winreg.QueryValueEx(key, "DEEPSEEK_API_KEY")
            val = (val or "").strip()
            if val:
                return val
    except Exception:
        pass
    # 3) Windows 注册表：系统级 HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment
    try:
        import winreg
        with winreg.OpenKey(
            winreg.HKEY_LOCAL_MACHINE,
            r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment",
        ) as key:
            val, _ = winreg.QueryValueEx(key, "DEEPSEEK_API_KEY")
            val = (val or "").strip()
            if val:
                return val
    except Exception:
        pass
    return ""

def build_env():
    env = dict(os.environ)
    key = get_api_key()
    if key:
        env["DEEPSEEK_API_KEY"] = key
    # 让 dsh 使用本机实际路由（按 dump-config：provider=deepseek-official, model=deepseek-flash）
    env["DEEPSEEK_PROVIDER"] = DSH_PROVIDER
    env["DEEPSEEK_MODEL"] = DSH_MODEL
    return env

# ---------- 工具函数 ----------
def md5_of_file(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        h.update(f.read())
    return h.hexdigest()

def find_proposals():
    found = []
    if not os.path.isdir(PROJECTS_DIR):
        return found
    for name in sorted(os.listdir(PROJECTS_DIR)):
        proj = os.path.join(PROJECTS_DIR, name)
        if not os.path.isdir(proj):
            continue
        for cand in [
            os.path.join(proj, "WORKSPACE", "PROPOSAL.md"),
            os.path.join(proj, "PROPOSAL.md"),
        ]:
            if os.path.isfile(cand):
                found.append((name, cand, md5_of_file(cand)))
                break
    return found

def load_state():
    if os.path.isfile(STATE_FILE):
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {"known": {}}

def save_state(state):
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=2)

def build_prompt(proj_name, prop_path):
    rules = []
    for r in [
        os.path.join(BASE_DIR, "AGENTS.md"),
        os.path.join(BASE_DIR, "META", "REGRESSION.md"),
        os.path.join(BASE_DIR, "META", "ROUTE.md"),
        os.path.join(BASE_DIR, "skills", "propose-gate", "SKILL.md"),
        os.path.join(BASE_DIR, "skills", "gate-review", "SKILL.md"),
    ]:
        if os.path.isfile(r):
            with open(r, "r", encoding="utf-8", errors="replace") as fh:
                rules.append("# 规则文件 " + os.path.relpath(r, BASE_DIR) + "\n" + fh.read())
    with open(prop_path, "r", encoding="utf-8", errors="replace") as fh:
        prop_text = fh.read()
    sys_prompt = (
        "你是 agent-os 的 propose-gate 评审员。只基于下面规则与提案产出对 BASE 的修改建议，"
        "不执行合并、不执行 git 写操作。输出格式：\n"
        "1) 摘要；2) 拟修改/新增文件清单；\n"
        "3) 每个文件给出 unified diff 或完整新内容；4) 自评估风险等级（低/中/高）与触发回归探针；\n"
        "5) 若不符合 META/REGRESSION 门槛，说明驳回理由。\n"
        + "\n\n".join(rules)
    )
    user_prompt = (
        "项目：" + proj_name + "\n提案文件：" + prop_path + "\n\n# 提案内容\n" + prop_text
    )
    return sys_prompt, user_prompt

def run_headless(sys_prompt, user_prompt):
    full_task = ("SYSTEM_RULES_START\n" + sys_prompt + "\nSYSTEM_RULES_END\n\n"
                 + "USER_TASK_START\n" + user_prompt + "\nUSER_TASK_END")
    # dsh shim 本质是 node <…>\@deepseek-ai\dsh\lib\bin.js %*（见 .bin\dsh.cmd）
    # 直接调用 node 执行 JS 入口：绕过 cmd /c 的 8191 字符上限（CreateProcess 上限 32767，长任务放得下）
    _bin_dir = os.path.dirname(shutil.which("dsh.cmd") or shutil.which("dsh") or "")
    _dsh_js = os.path.normpath(os.path.join(_bin_dir, "..", "@deepseek-ai", "dsh", "lib", "bin.js"))
    cmd = ["node", _dsh_js, "--profile", DSH_PROFILE, full_task]
    env = build_env()
    if not env.get("DEEPSEEK_API_KEY"):
        return "[FATAL] 未找到 DEEPSEEK_API_KEY（进程环境变量、HKCU、HKLM 均无）", 2
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True, text=True,
            encoding="utf-8", errors="replace",
            env=env, timeout=1800,
        )
        out = proc.stdout or ""
        if proc.stderr:
            out = out + "\n[STDERR]\n" + proc.stderr
        return out, proc.returncode
    except Exception as e:
        return "headless 调用失败：" + str(e), 1

def main():
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:
        pass
    os.makedirs(PENDING_DIR, exist_ok=True)
    state = load_state()
    first_run = (len(state.get("known", {})) == 0)
    proposals = find_proposals()
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    new_items, historical = [], 0

    for name, path, h in proposals:
        if state.get("known", {}) .get(path) == h:
            continue
        if first_run:
            state.setdefault("known", {})[path] = h
            historical += 1
        else:
            new_items.append((name, path, h))
            state.setdefault("known", {})[path] = h
    save_state(state)

    for name, path, h in new_items:
        date_str = now[:10]
        slug = re.sub(r"[^0-9A-Za-z_-]", "-", name)
        pending_md = os.path.join(PENDING_DIR, slug + "-" + date_str + ".md")
        review_txt = os.path.join(PENDING_DIR, slug + "-" + date_str + ".review.txt")
        with open(pending_md, "w", encoding="utf-8") as f:
            f.write("# 待人工复核提案\n\n- 项目：" + name
                    + "\n- 提案：" + path
                    + "\n- 哈希：" + h
                    + "\n- 时间：" + now
                    + "\n- 状态：waiting-gate\n")
        review_out, rc = "", 0
        if REVIEW_ENABLED:
            sys_p, user_p = build_prompt(name, path)
            review_out, rc = run_headless(sys_p, user_p)
        with open(review_txt, "w", encoding="utf-8") as f:
            f.write("# dsh headless 评审草案\n# 项目=" + name
                    + " 提案=" + path
                    + " rc=" + str(rc) + " time=" + now + "\n\n")
            f.write(review_out.strip() if review_out.strip() else "(无输出)")
        print("[新提案] " + name + " -> 待办 " + pending_md)
        print("[评审]   " + name + " -> 草案 " + review_txt + " (rc=" + str(rc) + ")")

    print("=" * 50)
    print("运行时间：" + now)
    print("扫描项目数：" + str(len(proposals)))
    print("首次登记历史：" + str(historical))
    print("新提案：" + str(len(new_items)))
    if not proposals:
        print("提示：PROJECTS 下未找到 PROPOSAL.md")
    print("状态文件：" + STATE_FILE)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("错误：" + str(e))
        sys.exit(1)
