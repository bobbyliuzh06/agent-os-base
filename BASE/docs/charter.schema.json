{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bobbyliuzh06/agent-os-base/blob/main/BASE/docs/charter.schema.json",
  "title": "agent-os Project charter 机器可读契约（v0.5.0 第一版）",
  "description": "Project 层接口契约第一块：charter.yaml 的字段收敛。生态可扩展=按此 schema 编写新项目章程。",
  "type": "object",
  "required": ["id", "name", "mission", "evaluation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string"},
    "kind": {"type": "string", "enum": ["deliverable-maintained", "self-evolving-system"]},
    "mission": {"type": "string"},
    "audience": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "approval_points": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "人机分界声明：自动 vs 人工"
    },
    "cadence": {"type": "string", "enum": ["daily", "weekly", "event"], "description": "白名单节奏模板"},
    "truth_sources": {"type": "array", "items": {"type": "string"}},
    "evaluation": {
      "type": "object",
      "required": ["domain", "metrics"],
      "properties": {
        "domain": {"type": "string", "description": "评估域：paper-performance / showcase-feedback / link-freshness / process-health ..."},
        "purpose": {"type": "string"},
        "target": {"type": "string"},
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "direction", "source"],
            "properties": {
              "name": {"type": "string"},
              "direction": {"type": "string", "enum": ["gt", "gte", "eq"]},
              "target": {},
              "source": {"type": "string"}
            }
          }
        },
        "degradation": {"type": "string", "description": "真值缺失时的显式降级声明（必须）"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "roadmap": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
